{
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "PYTHONPATH": "${workspaceFolder}/src"
    }
  },
  "tasks": [
    {
      "args": ["scripts/api/api_shell.py", "--reload"],
      "command": "python",
      "isBackground": true,
      "label": "genesis-v2: api shell",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": ["scripts/mcp/mcp_stdio.py"],
      "command": "python",
      "isBackground": true,
      "label": "genesis-v2: mcp stdio",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": ["scripts/smoke/smoke_suite.py"],
      "command": "python",
      "label": "genesis-v2: smoke suite",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "type": "shell"
    },
    {
      "args": ["scripts/validate/pytest_suite.py", "-q"],
      "command": "python",
      "group": {
        "isDefault": true,
        "kind": "test"
      },
      "label": "genesis-v2: pytest",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "type": "shell"
    }
  ],
  "version": "2.0.0"
}
